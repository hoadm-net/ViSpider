# Environment Configuration for ViSpider
# This file is a template. Copy to .env and add your actual values if needed.

# Note: LaBSE model runs locally, no API keys required for embeddings.

# OpenAI API (optional, for comparison experiments)
OPENAI_API_KEY=your_openai_api_key_here

